{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "bharat-api",

  "main": "src/index.ts",

  "compatibility_date": "2026-09-22",

  "observability": {
    "enabled": true
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1-rate-limiter",
      "new_sqlite_classes": ["RateLimiter"]
    }
  ]
}